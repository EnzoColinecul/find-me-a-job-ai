# Copy to .env.local (git-ignored). Values come from the deployed Auth stack outputs.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_COGNITO_CLIENT_ID=          # AuthStack output: UserPoolClientId
NEXT_PUBLIC_COGNITO_DOMAIN=https://fmaj-test.auth.ap-southeast-2.amazoncognito.com  # AuthStack output: CognitoDomain
# BROWSER Google Maps key (separate from fmaj/test/places-key!):
# restricted by HTTP referrer (localhost:3000), APIs: Maps JavaScript API + Places API
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
