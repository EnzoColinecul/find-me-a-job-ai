# Copy to .env and fill in. NEVER commit .env.
# ── AWS ───────────────────────────────────────────────────
AWS_PROFILE=fmaj-deploy
AWS_REGION=ap-southeast-2
# Deploy role: arn:aws:iam::418862088910:role/find-me-a-job-ai_role

# ── Google ────────────────────────────────────────────────
# Path to GCP IaC service account key (keep OUTSIDE git)
GOOGLE_APPLICATION_CREDENTIALS=./project-7187e8cf-43d5-451b-be4-84a9aac3c5df.json

# ── Stage ─────────────────────────────────────────────────
FMAJ_STAGE=test
FMAJ_AWS_REGION=ap-southeast-2

# ── External API keys ─────────────────────────────────────
# In the cloud these come from Secrets Manager (fmaj/{stage}/*).
# For LOCAL agent iteration only, set these env vars to bypass Secrets Manager:
# FMAJ_PLACES_KEY=
# FMAJ_ADZUNA_APP_ID=
# FMAJ_ADZUNA_APP_KEY=
# FMAJ_SERPAPI_KEY=

# ── Per-search budgets (agent/src/fmaj_agent/config.py) ───
# SerpAPI's free tier is ~250 searches a MONTH and that is the binding limit on
# how often we can run at all. Companies are investigated in parallel, so the
# ceiling is arithmetic:
#
#     worst case SerpAPI calls per search = MAX_COMPANIES x MAX_WEB_SEARCHES
#
# Defaults below are the PoC setting: 5 x 2 = 10 per search -> ~25 searches/mo.
# SET ANY OF THESE TO 0 FOR UNLIMITED — that's how production drops the guard
# rails without a code change. (Companies still cap at 40 regardless: Place
# Details is the Enterprise SKU at 1K/month.)
# FMAJ_MAX_COMPANIES=5
# FMAJ_MAX_WEB_SEARCHES=2
# FMAJ_MAX_TOOL_CALLS=8
# FMAJ_MAX_SECONDS=60
