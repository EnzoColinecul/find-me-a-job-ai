# Copy to .env and fill in. NEVER commit .env.
# ── AWS ───────────────────────────────────────────────────
AWS_PROFILE=fmaj-deploy
AWS_REGION=ap-southeast-2
# Deploy role: arn:aws:iam::418862088910:role/find-me-a-job-ai_role

# ── Google ────────────────────────────────────────────────
# Path to GCP IaC service account key (keep OUTSIDE git)
GOOGLE_APPLICATION_CREDENTIALS=./project-7187e8cf-43d5-451b-be4-84a9aac3c5df.json

# ── Stage ─────────────────────────────────────────────────
FMAJ_STAGE=test
FMAJ_AWS_REGION=ap-southeast-2

# ── External API keys ─────────────────────────────────────
# In the cloud these come from Secrets Manager (fmaj/{stage}/*).
# For LOCAL agent iteration only, set these env vars to bypass Secrets Manager:
# FMAJ_PLACES_KEY=
# FMAJ_ADZUNA_APP_ID=
# FMAJ_ADZUNA_APP_KEY=
# FMAJ_SERPAPI_KEY=
